<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ThinkPad Dashboard</vendor>
  <action id="io.github.thinkpaddashboard.control">
    <description>Access ThinkPad hardware controls and protected information</description>
    <message>Administrator authentication is required to access ThinkPad hardware controls or protected information</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/thinkpad-dashboard/thinkpad-dashboard-helper</annotate>
  </action>
</policyconfig>
